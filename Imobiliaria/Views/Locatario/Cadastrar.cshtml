@model Imobiliaria.Models.Cliente

<h2>Cadastro de Locatário</h2>

<form asp-action="Cadastrar" method="post">
    @Html.AntiForgeryToken()

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    else if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @Html.ValidationSummary(true, "Por favor corrija os erros abaixo.")

    <input type="hidden" asp-for="TipoCliente" value="Locador" />

    <div class="mb-3">
        <label asp-for="Nome" class="form-label"></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CPF" class="form-label">CPF (se aplicável)</label>
        <input asp-for="CPF" class="form-control" />
        <span asp-validation-for="CPF" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Telefone" class="form-label"></label>
        <input asp-for="Telefone" class="form-control" />
        <span asp-validation-for="Telefone" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TipoPessoa" class="form-label">Tipo de pessoa</label>
        <select asp-for="TipoPessoa" class="form-select" id="tipoPessoa">
            <option value="Fisica">Física</option>
            <option value="Juridica">Jurídica</option>
        </select>
        <span asp-validation-for="TipoPessoa" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label id="labelCpfCnpj" class="form-label">CPF</label>
        <input asp-for="CNPJ" id="cpfCnpj" class="form-control" />
        <span asp-validation-for="CNPJ" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DocumentoIdentidade" class="form-label">Documento (RG)</label>
        <input asp-for="DocumentoIdentidade" class="form-control" />
        <span asp-validation-for="DocumentoIdentidade" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Endereco" class="form-label">Endereço completo</label>
        <input asp-for="Endereco" class="form-control" />
        <span asp-validation-for="Endereco" class="text-danger"></span>
    </div>

    <h4>Dados bancários (opcionais)</h4>
    <div class="mb-3">
        <label asp-for="BancoNome" class="form-label"></label>
        <input asp-for="BancoNome" class="form-control" />
        <span asp-validation-for="BancoNome" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="BancoAgencia" class="form-label"></label>
        <input asp-for="BancoAgencia" class="form-control" />
        <span asp-validation-for="BancoAgencia" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="BancoConta" class="form-label"></label>
        <input asp-for="BancoConta" class="form-control" />
        <span asp-validation-for="BancoConta" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Cadastrar Locatário</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function(){
            var tipoPessoa = document.getElementById('tipoPessoa');
            var labelCpfCnpj = document.getElementById('labelCpfCnpj');
            var cpfCnpj = document.getElementById('cpfCnpj');

            function toggleCpfCnpj(){
                if(!tipoPessoa || !labelCpfCnpj) return;
                if(tipoPessoa.value === 'Juridica'){
                    labelCpfCnpj.textContent = 'CNPJ:';
                    cpfCnpj.setAttribute('name', 'CNPJ');
                } else {
                    labelCpfCnpj.textContent = 'CPF:';
                    cpfCnpj.setAttribute('name', 'CPF');
                }
            }

            if(tipoPessoa) tipoPessoa.addEventListener('change', toggleCpfCnpj);
            toggleCpfCnpj();
        })();
    </script>
}
