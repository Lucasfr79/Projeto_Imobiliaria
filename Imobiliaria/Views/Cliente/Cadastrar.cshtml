<h2>Cadastro de Cliente / Locador</h2>

@* Formulário simples de cadastro sem estilização.
   Opção de cadastro: escolha entre "Cliente" (quem aluga) e "Locador" (proprietário do imóvel).
   Campos obrigatórios definidos no modelo: Nome e CPF. *@

<form method="post">

    @* Nome: campo obrigatório para identificação do cliente/locador *@
    <label>Nome:</label>
    <input type="text" name="Nome" />
    <br />

    @* CPF: campo obrigatório para documento de identificação (somente números normalmente) *@
    <label>CPF:</label>
    <input type="text" name="CPF" />
    <br />

    @* Telefone: contato telefônico (opcional) *@
    <label>Telefone:</label>
    <input type="text" name="Telefone" />
    <br />

    @* Email: endereço de e-mail para contato (opcional) *@
    <label>Email:</label>
    <input type="text" name="Email" />
    <br />

    @* Endereço: endereço residencial ou comercial do cliente/locador (opcional) *@
    <label>Endereço:</label>
    <input type="text" name="Endereco" />
    <br />

    @* TipoCliente: define se o registro será como "Cliente" ou "Locador" *@
    <label>Tipo:</label>
    <select id="tipoCliente" name="TipoCliente">
        <option value="Cliente">Cliente</option>
        <option value="Locador">Locador</option>
    </select>
    <br />

    @* Campos adicionais exibidos somente quando TipoCliente == Locador *@
    <div id="locadorFields" style="display:none; margin-top:10px;">
        <h3>Informações adicionais para Locador</h3>

        <label>Tipo de pessoa:</label>
        <select id="tipoPessoa" name="TipoPessoa">
            <option value="Fisica">Física</option>
            <option value="Juridica">Jurídica</option>
        </select>
        <br />

        <label id="labelCpfCnpj">CPF:</label>
        <input type="text" id="cpfCnpj" name="CPF" />
        <br />

        <label>Documento (RG):</label>
        <input type="text" name="DocumentoIdentidade" />
        <br />

        <label>Endereço completo:</label>
        <input type="text" name="Endereco" />
        <br />

        <h4>Dados bancários (opcionais)</h4>
        <label>Banco:</label>
        <input type="text" name="BancoNome" />
        <br />
        <label>Agência:</label>
        <input type="text" name="BancoAgencia" />
        <br />
        <label>Conta:</label>
        <input type="text" name="BancoConta" />
        <br />
    </div>

    <button type="submit">Cadastrar</button>

</form>

<script>
    // Mostra/oculta campos extras quando o tipo for Locador
    (function(){
        var tipo = document.getElementById('tipoCliente');
        var locadorFields = document.getElementById('locadorFields');
        var tipoPessoa = document.getElementById('tipoPessoa');
        var labelCpfCnpj = document.getElementById('labelCpfCnpj');

        function toggleLocador(){
            if(tipo.value === 'Locador'){
                locadorFields.style.display = '';
            } else {
                locadorFields.style.display = 'none';
            }
        }

        function toggleCpfCnpj(){
            if(tipoPessoa && labelCpfCnpj){
                labelCpfCnpj.textContent = (tipoPessoa.value === 'Juridica') ? 'CNPJ:' : 'CPF:';
            }
        }

        tipo.addEventListener('change', toggleLocador);
        if(tipoPessoa) tipoPessoa.addEventListener('change', toggleCpfCnpj);

        // inicializa
        toggleLocador();
        toggleCpfCnpj();
    })();
</script>
